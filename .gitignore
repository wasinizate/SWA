# Dependencies
node_modules/

# Generated by scripts/copy-vendor-assets.js (a postinstall step) --
# third-party browser assets copied out of node_modules for the
# no-bundler renderer to load locally. Regenerated on every `npm install`.
src/renderer/vendor/

# Build output
dist/
out/

# Local database & vault files -- this is where all real user data lives.
# It must never be committed, even by accident.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
vault.json

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code tool settings/lock files -- not part of the project
.claude/

# Logs
*.log
npm-debug.log*
